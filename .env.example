# Copy to .env and fill in. Never commit .env.

# From @BotFather on Telegram
TELEGRAM_BOT_TOKEN=

# Airtable personal access token (needs data.records:read/write on the base)
AIRTABLE_API_KEY=

# The base ID, e.g. appXXXXXXXXXXXXXX (from airtable.com/api)
AIRTABLE_BASE_ID=

# Optional: group chat ID for the weekly schedule post (negative number)
TELEGRAM_GROUP_CHAT_ID=

# Optional: public HTTPS base URL for the planning / day-editor Mini Apps.
# Unset = those features are off. The web server binds PORT (Railway
# injects it; default 8080).
# WEBAPP_URL=https://your-app.example.com
# PORT=8080   (leave commented: an empty PORT= fails int() at startup)

# Optional: DEBUG / INFO / WARNING (default INFO)
LOG_LEVEL=INFO

# Optional: morning score snapshots to Google Sheets (both required to enable)
# Full JSON key of a Google service account with Sheets access;
# share the target spreadsheet with the service account's email.
GOOGLE_SERVICE_ACCOUNT_JSON=
# The spreadsheet ID from its URL (docs.google.com/spreadsheets/d/<THIS>/edit)
SCORE_SNAPSHOT_SHEET_ID=
